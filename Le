-- XỬ LÝ LOGIC QUÉT ID GAME HIỆN TẠI
-- ==========================================
task.spawn(function()
    local currentPlaceId = game.PlaceId
    ScanIdLabel.Text = "ID: " .. tostring(currentPlaceId)

    local matchedGame = nil
    for _, data in ipairs(gameList) do
        if extractPlaceId(data.input) == currentPlaceId then
            matchedGame = data
            break
        end
    end

    local success, info = pcall(function()
        return MarketplaceService:GetProductInfo(currentPlaceId)
    end)

    if success and info then
        ScanName.Text = info.Name
        if info.IconImageAssetId and info.IconImageAssetId > 0 then
            ScanThumb.Image = "rbxassetid://" .. tostring(info.IconImageAssetId)
        else
            ScanThumb.Image = "rbxassetid://" .. tostring(currentPlaceId)
        end
    else
        ScanName.Text = "Unknown Game"
        ScanThumb.Image = "rbxassetid://" .. tostring(currentPlaceId)
    end

    if matchedGame then
        ScanStatus.TextColor3 = Color3.fromRGB(0, 255, 128)
        ScanStatus.Text = "✓ Supported Game"
        ScanRunBtn.Visible = true

        ScanRunBtn.MouseButton1Click:Connect(function()
            local finalScript = matchedGame.scriptUrl or decryptUrl(matchedGame.scriptBytes)
            closeUI(function()
                task.spawn(function()
                    local success, err = pcall(function()
                        loadstring(finalScript)()
                    end)
                    if not success then
                        warn("error: " .. tostring(err))
                    end
                end)
            end)
        end)
    else
        ScanStatus.TextColor3 = Color3.fromRGB(255, 75, 75)
        ScanStatus.Text = "X Not Supported"
        ScanRunBtn.Visible = false
    end
end)
